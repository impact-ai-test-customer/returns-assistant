{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "prefix": { "value": "chooseprefix" },
    "location": { "value": "CHOOSE_SUPPORTED_REGION" },
    "githubRepository": { "value": "CUSTOMER_OWNER/CUSTOMER_REPOSITORY" },
    "modelName": { "value": "CHOOSE_MODEL_NAME" },
    "modelVersion": { "value": "CHOOSE_EXACT_MODEL_VERSION" },
